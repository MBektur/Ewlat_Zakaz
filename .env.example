# PostgreSQL bağlantı adresi.
# BOŞ BIRAKILIRSA site ÖNİZLEME modunda çalışır: veri tabanı yok, kitaplar ve fiyat örnek veriden gelir,
# sipariş formu kayıt yapmaz, admin paneli kapalıdır (Vercel'de yalnızca görmek için ideal).
DATABASE_URL=postgres://kullanici:sifre@localhost:5432/ewlat_kitap

# /admin paneline giriş şifresi (güçlü bir şifre seçin)
ADMIN_PASSWORD=

# Oturum çerezini imzalamak için rastgele uzun bir değer
# Üretmek için: openssl rand -hex 32
SESSION_SECRET=

# (İsteğe bağlı) Yeni sipariş bildirimi - Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
